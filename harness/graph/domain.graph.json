{
  "version": 1,
  "nodes": [
    {"id": "Session", "type": "entity", "attrs": ["id", "title", "status", "consent_state", "source"]},
    {"id": "AudioAsset", "type": "entity", "attrs": ["id", "session_id", "file_path", "encrypted", "checksum"]},
    {"id": "Transcript", "type": "entity", "attrs": ["id", "session_id", "raw_text", "status"]},
    {"id": "Engine", "type": "entity", "attrs": ["id", "mode", "install_state"]},
    {
      "id": "INV-NO-CLOUD-DEFAULT",
      "type": "invariant",
      "severity": "CRITICAL",
      "control_id": "CONTROL_NO_CLOUD_DEFAULT",
      "statement": "A fresh install never enables cloud STT or telemetry.",
      "ears": "WHEN the local store is created, THE SYSTEM SHALL set cloud_mode to off and telemetry to off."
    },
    {
      "id": "INV-NO-SILENT-CLOUD",
      "type": "invariant",
      "severity": "CRITICAL",
      "control_id": "CONTROL_NO_SILENT_CLOUD",
      "statement": "Engine fallback never selects cloud unless the user enabled it.",
      "ears": "WHEN the selected engine is unavailable, THE SYSTEM SHALL fall back only to a ready local engine."
    },
    {
      "id": "INV-CONSENT-BEFORE-RECORD",
      "type": "invariant",
      "severity": "CRITICAL",
      "control_id": "CONTROL_CONSENT",
      "statement": "Recording cannot start until the disclosure is acknowledged.",
      "ears": "WHEN recorder.start runs, THE SYSTEM SHALL require consent_state acknowledged."
    },
    {
      "id": "INV-AUDIO-ENCRYPTED",
      "type": "invariant",
      "severity": "CRITICAL",
      "control_id": "CONTROL_AUDIO_AT_REST",
      "statement": "Finalized audio on disk is ciphertext, not a WAV.",
      "ears": "WHEN audio is finalized, THE SYSTEM SHALL write a file whose first bytes are not RIFF/WAVE."
    },
    {
      "id": "INV-FTS-SEARCH",
      "type": "invariant",
      "severity": "HIGH",
      "control_id": "CONTROL_LOCAL_SEARCH",
      "statement": "Stored transcript text is locally searchable.",
      "ears": "WHEN a transcript is stored, THE SYSTEM SHALL return it from search.query for a distinctive term."
    },
    {
      "id": "INV-DELETE-ALL",
      "type": "invariant",
      "severity": "HIGH",
      "control_id": "CONTROL_DELETE_ALL",
      "statement": "Delete-all removes sessions, FTS rows, and audio files.",
      "ears": "WHEN delete_all runs, THE SYSTEM SHALL make prior transcript text unsearchable."
    },
    {
      "id": "INV-FIXTURE-LOCK",
      "type": "invariant",
      "severity": "HIGH",
      "control_id": "CONTROL_FIXTURE_LOCK",
      "statement": "Golden fixtures are content-addressed.",
      "ears": "WHEN fixtures are validated, THE SYSTEM SHALL verify SHA-256 digests against harness/graph/fixture-lock.json."
    },
    {
      "id": "INV-CAPTURE-WAV",
      "type": "invariant",
      "severity": "HIGH",
      "control_id": "CONTROL_CAPTURE_WAV",
      "statement": "Sine capture produces a valid 16 kHz mono WAV.",
      "ears": "WHEN record_sine runs for a positive duration, THE SYSTEM SHALL return RIFF/WAVE PCM bytes."
    },
    {
      "id": "INV-PAUSE-RESUME",
      "type": "invariant",
      "severity": "HIGH",
      "control_id": "CONTROL_PAUSE_RESUME",
      "statement": "Paused PCM is not part of duration.",
      "ears": "WHEN a ChunkedRecorder is paused, THE SYSTEM SHALL ignore PCM until resume."
    },
    {
      "id": "INV-CRASH-PARTIAL",
      "type": "invariant",
      "severity": "HIGH",
      "control_id": "CONTROL_CRASH_PARTIAL",
      "statement": "Flushed chunks are recoverable if stop never runs.",
      "ears": "WHEN ChunkedRecorder is dropped after flush, THE SYSTEM SHALL recover a valid WAV."
    },
    {
      "id": "INV-DEMO-STILL-OFFLINE",
      "type": "invariant",
      "severity": "CRITICAL",
      "control_id": "CONTROL_DEMO_OFFLINE",
      "statement": "Demo path stays fixture and offline after live capture lands.",
      "ears": "WHEN demo_pipeline runs, THE SYSTEM SHALL use fixture-replay and zero network_calls."
    },
    {
      "id": "INV-CAPTURE-UNSUPPORTED",
      "type": "invariant",
      "severity": "HIGH",
      "control_id": "CONTROL_CAPTURE_UNSUPPORTED",
      "statement": "Missing system-audio backend is a recoverable error, not a cloud fallback.",
      "ears": "WHEN start_live(System) has no tap, THE SYSTEM SHALL return CAPTURE_UNSUPPORTED."
    },
    {"id": "SPEC-STORE", "type": "spec", "kiro_name": "session-store", "wave": [1, 2]},
    {"id": "SPEC-CAPTURE", "type": "spec", "kiro_name": "capture-consent", "wave": [3, 4]},
    {"id": "SPEC-SEARCH", "type": "spec", "kiro_name": "search-notes", "wave": [5, 6]},
    {"id": "SPEC-LIVE", "type": "spec", "kiro_name": "live-capture", "wave": [7, 8]},
