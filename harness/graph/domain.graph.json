    {"id": "CT-delete-all", "type": "contract_test", "path": "src-tauri/tests/contract.rs"},
    {"id": "CT-fixtures-lock", "type": "contract_test", "path": "tests/contract/test_fixtures.py"},
    {"id": "CT-capture-wav", "type": "contract_test", "path": "src-tauri/tests/contract.rs"},
