{
  "version": 1,
  "nodes": [
    {"id": "Session", "type": "entity", "attrs": ["id", "title", "status", "consent_state", "source"]},
    {"id": "AudioAsset", "type": "entity", "attrs": ["id", "session_id", "file_path", "encrypted", "checksum"]},
    {"id": "Transcript", "type": "entity", "attrs": ["id", "session_id", "raw_text", "status"]},
    {"id": "Engine", "type": "entity", "attrs": ["id", "mode", "install_state"]},
    {
      "id": "INV-NO-CLOUD-DEFAULT",
      "type": "invariant",
      "severity": "CRITICAL",
      "control_id": "CONTROL_NO_CLOUD_DEFAULT",
      "statement": "A fresh install never enables cloud STT or telemetry.",
      "ears": "WHEN the local store is created, THE SYSTEM SHALL set cloud_mode to off and telemetry to off."
    },
    {
      "id": "INV-NO-SILENT-CLOUD",
      "type": "invariant",
      "severity": "CRITICAL",
      "control_id": "CONTROL_NO_SILENT_CLOUD",
      "statement": "Engine fallback never selects cloud unless the user enabled it.",
      "ears": "WHEN the selected engine is unavailable, THE SYSTEM SHALL fall back only to a ready local engine."
    },
    {
      "id": "INV-CONSENT-BEFORE-RECORD",
      "type": "invariant",
      "severity": "CRITICAL",
      "control_id": "CONTROL_CONSENT",
      "statement": "Recording cannot start until the disclosure is acknowledged.",
      "ears": "WHEN recorder.start runs, THE SYSTEM SHALL require consent_state acknowledged."
    },
    {
      "id": "INV-AUDIO-ENCRYPTED",
      "type": "invariant",
      "severity": "CRITICAL",
      "control_id": "CONTROL_AUDIO_AT_REST",
      "statement": "Finalized audio on disk is ciphertext, not a WAV.",
      "ears": "WHEN audio is finalized, THE SYSTEM SHALL write a file whose first bytes are not RIFF/WAVE."
    },
    {
      "id": "INV-FTS-SEARCH",
      "type": "invariant",
      "severity": "HIGH",
      "control_id": "CONTROL_LOCAL_SEARCH",
      "statement": "Stored transcript text is locally searchable.",
      "ears": "WHEN a transcript is stored, THE SYSTEM SHALL return it from search.query for a distinctive term."
    },
    {
      "id": "INV-DELETE-ALL",
      "type": "invariant",
      "severity": "HIGH",
      "control_id": "CONTROL_DELETE_ALL",
      "statement": "Delete-all removes sessions, FTS rows, and audio files.",
      "ears": "WHEN delete_all runs, THE SYSTEM SHALL make prior transcript text unsearchable."
    },
    {
      "id": "INV-FIXTURE-LOCK",
      "type": "invariant",
      "severity": "HIGH",
      "control_id": "CONTROL_FIXTURE_LOCK",
      "statement": "Golden fixtures are content-addressed.",
      "ears": "WHEN fixtures are validated, THE SYSTEM SHALL verify SHA-256 digests against harness/graph/fixture-lock.json."
    },
    {
      "id": "INV-CAPTURE-WAV",
      "type": "invariant",
      "severity": "HIGH",
      "control_id": "CONTROL_CAPTURE_WAV",
      "statement": "Sine capture produces a valid 16 kHz mono WAV.",
      "ears": "WHEN record_sine runs for a positive duration, THE SYSTEM SHALL return RIFF/WAVE PCM bytes."
    },
    {
      "id": "INV-PAUSE-RESUME",
      "type": "invariant",
      "severity": "HIGH",
      "control_id": "CONTROL_PAUSE_RESUME",
      "statement": "Paused PCM is not part of duration.",
      "ears": "WHEN a ChunkedRecorder is paused, THE SYSTEM SHALL ignore PCM until resume."
    },
    {
      "id": "INV-CRASH-PARTIAL",
      "type": "invariant",
      "severity": "HIGH",
      "control_id": "CONTROL_CRASH_PARTIAL",
      "statement": "Flushed chunks are recoverable if stop never runs.",
      "ears": "WHEN ChunkedRecorder is dropped after flush, THE SYSTEM SHALL recover a valid WAV."
    },
    {
      "id": "INV-DEMO-STILL-OFFLINE",
      "type": "invariant",
      "severity": "CRITICAL",
      "control_id": "CONTROL_DEMO_OFFLINE",
      "statement": "Demo path stays fixture and offline after live capture lands.",
      "ears": "WHEN demo_pipeline runs, THE SYSTEM SHALL use fixture-replay and zero network_calls."
    },
    {
      "id": "INV-CAPTURE-UNSUPPORTED",
      "type": "invariant",
      "severity": "HIGH",
      "control_id": "CONTROL_CAPTURE_UNSUPPORTED",
      "statement": "Missing system-audio backend is a recoverable error, not a cloud fallback.",
      "ears": "WHEN start_live(System) has no tap, THE SYSTEM SHALL return CAPTURE_UNSUPPORTED."
    },
    {
      "id": "INV-WHISPER-LOCAL-ONLY",
      "type": "invariant",
      "severity": "CRITICAL",
      "control_id": "CONTROL_WHISPER_LOCAL",
      "statement": "Whisper without local weights is ENGINE_NOT_INSTALLED, never cloud or silent fixture.",
      "ears": "WHEN transcribe_local runs for whisper-large-v3-turbo without weights, THE SYSTEM SHALL return ENGINE_NOT_INSTALLED."
    },
    {
      "id": "INV-DEMO-NO-DOWNLOAD",
      "type": "invariant",
      "severity": "CRITICAL",
      "control_id": "CONTROL_DEMO_NO_DOWNLOAD",
      "statement": "Demo path never downloads model weights.",
      "ears": "WHEN demo_pipeline runs, THE SYSTEM SHALL keep network_calls at 0 and SHALL NOT write Whisper weights."
    },
    {
      "id": "INV-WHISPER-WEIGHTS-LOCAL",
      "type": "invariant",
      "severity": "HIGH",
      "control_id": "CONTROL_WHISPER_FILE",
      "statement": "A present weights file is consulted locally; invalid ggml is not a network fetch.",
      "ears": "WHEN whisper_weights_path exists but is not a valid model, THE SYSTEM SHALL return ENGINE_MODEL_INVALID."
    },
    {"id": "SPEC-STORE", "type": "spec", "kiro_name": "session-store", "wave": [1, 2]},
    {"id": "SPEC-CAPTURE", "type": "spec", "kiro_name": "capture-consent", "wave": [3, 4]},
    {"id": "SPEC-SEARCH", "type": "spec", "kiro_name": "search-notes", "wave": [5, 6]},
    {"id": "SPEC-LIVE", "type": "spec", "kiro_name": "live-capture", "wave": [7, 8]},
    {"id": "SPEC-STT", "type": "spec", "kiro_name": "local-stt", "wave": [9, 10]},
    {
      "id": "INV-CHECKSUM",
      "type": "invariant",
      "severity": "CRITICAL",
      "control_id": "CONTROL_CHECKSUM",
      "statement": "A model payload that fails SHA-256 is rejected and not kept on disk.",
      "ears": "WHEN install_bytes sees a digest mismatch, THE SYSTEM SHALL return CHECKSUM_MISMATCH and SHALL NOT leave weights."
    },
    {
      "id": "INV-PARAKEET-LOCAL",
      "type": "invariant",
      "severity": "CRITICAL",
      "control_id": "CONTROL_PARAKEET_LOCAL",
      "statement": "Parakeet is a local file plus overlay, never cloud, never silent fixture.",
      "ears": "WHEN Parakeet weights are missing, THE SYSTEM SHALL return ENGINE_NOT_INSTALLED; WHEN they are checksum-valid, overlay SHALL be ready."
    },
    {"id": "SPEC-INSTALL", "type": "spec", "kiro_name": "model-install", "wave": [11, 12]},
    {
      "id": "INV-SUMMARY-FROM-TRANSCRIPT",
      "type": "invariant",
      "severity": "HIGH",
      "control_id": "CONTROL_EXTRACTIVE_NOTES",
      "statement": "Notes are derived locally from the transcript, never a cloud LLM.",
      "ears": "WHEN extract_notes runs, THE SYSTEM SHALL keep distinctive transcript claims in the notes."
    },
    {
      "id": "INV-EXPORT-FILE",
      "type": "invariant",
      "severity": "HIGH",
      "control_id": "CONTROL_EXPORT_FILE",
      "statement": "Export writes markdown to a local path.",
      "ears": "WHEN export_markdown_file runs, THE SYSTEM SHALL write a file containing the transcript."
    },
    {
      "id": "INV-SETTINGS-PRIVACY",
      "type": "invariant",
      "severity": "CRITICAL",
      "control_id": "CONTROL_SETTINGS_PRIVACY",
      "statement": "Privacy settings default to telemetry off and cloud off.",
      "ears": "WHEN privacy_settings is read on a fresh store, THE SYSTEM SHALL report telemetry off and cloud_mode off."
    },
    {"id": "SPEC-NOTES", "type": "spec", "kiro_name": "notes-export", "wave": [13, 14]},
    {
      "id": "INV-FILTER-DATE",
      "type": "invariant",
      "severity": "HIGH",
      "control_id": "CONTROL_FILTER_DATE",
      "statement": "Search date range returns only sessions created inside the inclusive bounds.",
      "ears": "WHEN search_filtered is given created_from and created_to, THE SYSTEM SHALL omit sessions outside that range."
    },
    {
      "id": "INV-TAG-ROUNDTRIP",
      "type": "invariant",
      "severity": "HIGH",
      "control_id": "CONTROL_TAGS",
      "statement": "Tags persist locally and can filter search.",
      "ears": "WHEN set_tags runs, THE SYSTEM SHALL return the same tags from list_tags and from tag search."
    },
    {"id": "SPEC-FILTERS", "type": "spec", "kiro_name": "search-filters", "wave": [15, 16]},
    {
      "id": "INV-KEYCHAIN",
      "type": "invariant",
      "severity": "CRITICAL",
      "control_id": "CONTROL_KEYSTORE",
      "statement": "Master key is 32 bytes in Keychain on macOS or a 0600 file elsewhere.",
      "ears": "WHEN the store opens, THE SYSTEM SHALL persist the master key via KeyStore and reuse it on reopen."
    },
    {
      "id": "INV-RETENTION",
      "type": "invariant",
      "severity": "HIGH",
      "control_id": "CONTROL_RETENTION",
      "statement": "Positive retention_days deletes older sessions and their audio.",
      "ears": "WHEN apply_retention runs with retention_days > 0, THE SYSTEM SHALL delete sessions older than that window."
    },
    {"id": "SPEC-HARDEN", "type": "spec", "kiro_name": "harden", "wave": [17, 18]},
    {
      "id": "INV-FILTER-TITLE",
      "type": "invariant",
      "severity": "HIGH",
      "control_id": "CONTROL_FILTER_TITLE",
      "statement": "Title substring filter works without an FTS query.",
      "ears": "WHEN search_filtered is given only title, THE SYSTEM SHALL return matching sessions."
    },
    {"id": "SPEC-DESK", "type": "spec", "kiro_name": "desk-closeout", "wave": [19, 20]},
    {"id": "CT-no-cloud-default", "type": "contract_test", "path": "tests/contract/test_catalog.py"},
    {"id": "CT-no-silent-cloud", "type": "contract_test", "path": "src-tauri/src/engines.rs"},
    {"id": "CT-consent-before-record", "type": "contract_test", "path": "src-tauri/src/store.rs"},
    {"id": "CT-audio-encrypted", "type": "contract_test", "path": "src-tauri/tests/contract.rs"},
