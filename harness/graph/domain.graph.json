    {"id": "CT-demo-still-offline", "type": "contract_test", "path": "src-tauri/tests/contract.rs"},
    {"id": "CT-mic-unsupported-is-recoverable", "type": "contract_test", "path": "src-tauri/tests/contract.rs"},
    {"id": "CT-whisper-local-only", "type": "contract_test", "path": "src-tauri/tests/contract.rs"},
    {"id": "CT-demo-no-download", "type": "contract_test", "path": "src-tauri/tests/contract.rs"},
    {"id": "CT-whisper-weights-are-local", "type": "contract_test", "path": "src-tauri/tests/contract.rs"},
    {"id": "CT-checksum", "type": "contract_test", "path": "src-tauri/tests/contract.rs"},
    {"id": "CT-parakeet-local", "type": "contract_test", "path": "src-tauri/tests/contract.rs"},
    {"id": "CT-summary-from-transcript", "type": "contract_test", "path": "src-tauri/tests/contract.rs"},
    {"id": "CT-export-file", "type": "contract_test", "path": "src-tauri/tests/contract.rs"},
    {"id": "CT-settings-privacy", "type": "contract_test", "path": "src-tauri/tests/contract.rs"},
    {"id": "CT-filter-date", "type": "contract_test", "path": "src-tauri/tests/contract.rs"},
    {"id": "CT-tag-roundtrip", "type": "contract_test", "path": "src-tauri/tests/contract.rs"},
    {"id": "CT-keychain", "type": "contract_test", "path": "src-tauri/tests/contract.rs"},
    {"id": "CT-retention", "type": "contract_test", "path": "src-tauri/tests/contract.rs"},
    {"id": "CT-filter-title", "type": "contract_test", "path": "src-tauri/tests/contract.rs"},
    {
      "id": "INV-LIVE-STOP-NOT-FIXTURE",
      "type": "invariant",
      "severity": "HIGH",
      "control_id": "CONTROL_LIVE_STOP",
      "statement": "Live finalize encrypts chunk WAV, never CONSULT-001.",
      "ears": "WHEN finalize_live runs on a ChunkedRecorder, THE SYSTEM SHALL encrypt that WAV and SHALL NOT substitute the golden fixture."
    },
    {
      "id": "INV-FIXTURE-AUDIO-MISMATCH",
      "type": "invariant",
      "severity": "HIGH",
      "control_id": "CONTROL_FIXTURE_AUDIO",
      "statement": "fixture-replay refuses audio that is not CONSULT-001.",
      "ears": "WHEN transcribe_local uses fixture-replay on non-golden WAV, THE SYSTEM SHALL return FIXTURE_AUDIO_MISMATCH."
    },
    {"id": "SPEC-LIVE-RECORD", "type": "spec", "kiro_name": "live-record", "wave": [21, 22]},
    {"id": "CT-live-stop-not-fixture", "type": "contract_test", "path": "src-tauri/tests/contract.rs"},
    {"id": "CT-fixture-audio-mismatch", "type": "contract_test", "path": "src-tauri/tests/contract.rs"}
  ],
